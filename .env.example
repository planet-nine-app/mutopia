# Mutopia Environment Configuration
# Copy this file to .env and adjust as needed

# ============================================================================
# SERVICE PORTS
# ============================================================================
SANORA_PORT=9090
FAIRCAMP_PORT=8000
DOLORES_PORT=5118
MIRLO_CLIENT_PORT=3000
MIRLO_API_PORT=3001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
JAM_COOP_PORT=3002

# ============================================================================
# DATABASE CREDENTIALS
# ============================================================================
POSTGRES_USER=mirlo
POSTGRES_PASSWORD=mirlo
POSTGRES_DB=mirlo

REDIS_PASSWORD=mirlo

MINIO_ROOT_USER=mirlo
MINIO_ROOT_PASSWORD=mirlopassword

# ============================================================================
# CANIMUS FEED SOURCES
# ============================================================================
# These are the feeds that Mirlo will consume
# Add comma-separated URLs
CANIMUS_FEEDS=http://sanora:9090/feeds/canimus-feed.json,https://sockpuppet.band/canimus.json

# ============================================================================
# ALLYABASE INTEGRATION (Optional)
# ============================================================================
# If you have allyabase services running on the host machine
PROF_URL=http://host.docker.internal:5108
SANORA_URL=http://host.docker.internal:5121
CONTINUEBEE_URL=http://host.docker.internal:5112

# ============================================================================
# DEVELOPMENT vs PRODUCTION
# ============================================================================
NODE_ENV=development
